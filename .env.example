# Node 22.13+ required. Copy to .env and set credentials, then run npm run admin:setup.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/playnova.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# In production, serve behind HTTPS and set both values below.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Set TRUST_PROXY=1 ONLY behind exactly one trusted reverse proxy.
TRUST_PROXY=0
